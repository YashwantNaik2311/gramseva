# AWS
AWS_REGION=us-east-1

# Bedrock Mantle (DeepSeek v3.2 via OpenAI-compatible chat completions API)
# The API key is a short-term Bedrock credential obtained from the AWS console.
# It must NEVER be committed, logged, or exposed to the frontend.
BEDROCK_API_KEY=
BEDROCK_MANTLE_ENDPOINT=https://bedrock-mantle.us-east-1.api.aws/v1/chat/completions
DEEPSEEK_MODEL_ID=deepseek.v3.2

# Set to "mock" for local testing without live Bedrock Mantle access
PROFILE_EXTRACTOR_MODE=mantle

# DynamoDB / S3 names are injected by SAM; used only for local seed scripts
SCHEMES_TABLE=gramseva-schemes-dev
AUDIO_BUCKET=gramseva-audio-dev
